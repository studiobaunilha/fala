      }
    },
    "Whisper usa modelos OpenAI via WhisperKit. Ao trocar de motor o app pede confirmação e reinicia imediatamente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper uses OpenAI models via WhisperKit. When switching engines, the app asks for confirmation and restarts immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper usa modelos de OpenAI vía WhisperKit. Al cambiar de motor, la app pide confirmación y se reinicia de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper utilise les modèles OpenAI via WhisperKit. Lors du changement de moteur, l’app demande une confirmation et redémarre immédiatement."
          }
        }
      }
    },
    "Whisper usa modelos OpenAI via WhisperKit. Requer reiniciar o app após alterar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper uses OpenAI models via WhisperKit. Restart the app after changing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper usa modelos de OpenAI mediante WhisperKit. Reinicia la app después de cambiarlo."
