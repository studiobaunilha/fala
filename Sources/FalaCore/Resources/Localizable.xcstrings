    "Whisper está ativo. O mesmo modelo será usado tanto no ditado quanto na transcrição de arquivos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper is active. The same model will be used for both dictation and file transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper está activo. El mismo modelo se usará tanto para dictado como para transcripción de archivos."
          }
