    "Formate e corrija a transcrição abaixo, mantendo o idioma original e corrigindo pontuação.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format and correct the transcription below, keeping the original language and fixing punctuation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da formato y corrige la transcripción a continuación, manteniendo el idioma original y corrigiendo la puntuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez en forme et corrigez la transcription ci-dessous, en conservant la langue d’origine et en corrigeant la ponctuation."
          }
        }
      }
    },
    "Formate o texto transcrito, corrigindo pontuação, gramática e capitalização, mantendo o idioma original. Não altere o sentido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Format the transcribed text, correcting punctuation, grammar, and capitalization, matching the original language. Do not alter the meaning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatea el texto transcrito, corrigiendo puntuación, gramática y capitalización, manteniendo el idioma original. No alteres el sentido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez en forme le texte transcrit en corrigeant la ponctuation, la grammaire et les majuscules, tout en conservant la langue d’origine. Ne modifiez pas le sens."
          }
        }
      }
    },
